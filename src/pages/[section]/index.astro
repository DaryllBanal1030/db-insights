---
/* =============================================================================
   [section]/index.astro — ONE file that builds all five section pages:
   /spatial, /analytics, /automate, /learning and /notes.
   =============================================================================

   DYNAMIC ROUTES IN ASTRO:
   A folder or file name in [square brackets] is a parameter. Because the site
   is static, Astro must know every value up front, so the page exports
   getStaticPaths(): it returns one entry per page to build, and Astro renders
   this template once per entry with `Astro.params.section` set to that value.

   So there's no spatial.astro to edit — change the wording in
   src/lib/hub.ts (SECTIONS) and add posts in src/content/posts/.
============================================================================= */

import BaseLayout from "../../layouts/BaseLayout.astro";
import SubBrandTag from "../../components/SubBrandTag.astro";
import PostList from "../../components/PostList.astro";
import ComingSoon from "../../components/ComingSoon.astro";
import { BRAND, SECTIONS, SECTION_KEYS, type SectionKey } from "../../lib/hub";
import { getPosts, statusOf } from "../../lib/posts";

export function getStaticPaths() {
  // [{ params: { section: "spatial" } }, { params: { section: "analytics" } }, …]
  return SECTION_KEYS.map((section) => ({ params: { section } }));
}

const section = SECTIONS[Astro.params.section as SectionKey];
const posts = await getPosts(section.key);
// Field Notes is a section of the Masterbrand, not a Sub-brand, so its tag
// reads "DB Insights" rather than repeating "Field Notes".
const isSubBrand = section.key !== "notes";
// "Live" only once the section has a post (statusOf in posts.ts).
const status = await statusOf(section);
---

<BaseLayout
  title={`${section.name} · ${BRAND.name}`}
  description={`${section.focus} ${BRAND.bio}`}
>
  <section>
    <div class="mx-auto max-w-3xl px-6 pb-16 pt-12 sm:pb-20 sm:pt-16">
      <!-- Header: Sub-brand Tag, name, focus, and the status line. -->
      <div data-reveal>
        <!-- A thin bar in the Sub-brand Accent: the only other place it's used. -->
        <div class:list={["h-1 w-12 rounded-full", section.barClass]} aria-hidden="true"></div>
        <div class="mt-6">
          <SubBrandTag section={isSubBrand ? section : null} />
        </div>
        <h1 class="mt-4 text-balance text-4xl font-bold tracking-tight sm:text-5xl">
          {section.name}
        </h1>
        <p class="mt-4 max-w-prose text-lg text-muted">{section.focus}</p>
        <!-- Post Formats + status ("Live" / "First Data Story: Wed" / "From Jan 2027") as chips. The dots use the Sub-brand Accent
             (white/navy ink for Field Notes): it shows what the page is about. -->
        <ul class="mt-5 flex flex-wrap gap-2 text-sm">
          {
            [...section.formats, status.label].map((label) => (
              <li class="inline-flex items-center gap-2 rounded-full border border-border px-3 py-1 text-muted">
                <span class:list={["h-1.5 w-1.5 rounded-full", section.barClass]} aria-hidden="true" />
                {label}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Posts, or the coming-soon state if there are none yet. -->
      <div class="mt-10" data-reveal>
        {posts.length > 0 ? <PostList posts={posts} level={2} /> : <ComingSoon section={section} />}
      </div>
    </div>
  </section>
</BaseLayout>

---
/* =============================================================================
   [section]/[slug].astro — the page for a single post, e.g.
   /analytics/2026-11-11-what-1000-pesos-bought
   =============================================================================
   Two route parameters this time. getStaticPaths() returns one entry per
   published post, with both the section (from its Format) and the slug (the
   file name, which Astro calls the entry's `id`). Anything returned under
   `props` is handed to the page as Astro.props, so we pass the post along.

   render(post) turns the post's Markdown body into a <Content /> component.

   The header names the source in a few words (`sourceLine`) and numbers the
   post within its Format ("Map Breakdown #1"). Before the body's first
   section heading sits a small follow block (FollowInline.astro), so a
   reader who arrived from LinkedIn sees the ask early; the body is split on
   its first <h2> to place it. The page ends with the Public Source, then an
   end block: the byline, the
   next step on LinkedIn ("Answer on LinkedIn" once the post's linkedinUrl is
   filled in; "Follow on LinkedIn" to the profile until then), and a link to
   more posts from the same section, so a reader never hits a dead end.
============================================================================= */

import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SubBrandTag from "../../components/SubBrandTag.astro";
import { BRAND, FOLLOW_LINKS, RHYTHM, SECTIONS } from "../../lib/hub";
import FollowInline from "../../components/FollowInline.astro";
import {
  accentStyleOf,
  formatDate,
  formatLabel,
  getPosts,
  isUpcoming,
  plainTitle,
  sectionOf,
  tagOf,
  type Post,
} from "../../lib/posts";
import PostTitle from "../../components/PostTitle.astro";
import NewTabNote from "../../components/NewTabNote.astro";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { section: sectionOf(post), slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
// The body as HTML, split at its first section heading so the follow block
// can sit there. No <h2> (a short post) -> the block is left out.
const bodyHtml = post.rendered?.html ?? "";
const cut = bodyHtml.indexOf("<h2");
const splitBody = cut > 0;
const label = await formatLabel(post); // "Map Breakdown #1"
const section = SECTIONS[sectionOf(post)];

// The post's Sub-brand Accent, for its ==highlights== and bullets (see
// `.insight` and `.post-body li::marker` in global.css). A Masterbrand post
// (no tag) keeps Insight Gold highlights and white/navy bullets.
const accentStyle = accentStyleOf(post);

// The end block's LinkedIn button: the post itself once its URL is known,
// otherwise Daryll's profile.
const linkedin = FOLLOW_LINKS.find((link) => link.platform === "LinkedIn")!;
const postUrl = post.data.linkedinUrl;
---

<BaseLayout title={`${plainTitle(post.data.title)} · ${BRAND.name}`} description={post.data.summary}>
  <article class="mx-auto max-w-3xl px-6 pb-16 pt-12 sm:pb-20 sm:pt-16" style={accentStyle}>
    <!-- Back link to the section this post lives in. -->
    <a href={section.path} class="text-sm text-muted transition-colors hover:text-text">
      ← {section.name}
    </a>

    <header class="mt-8">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-faint">
        <SubBrandTag section={tagOf(post)} />
        <span>{label}</span>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.date.toISOString()}>
          {isUpcoming(post) ? "Coming " : ""}{formatDate(post.data.date)}
        </time>
      </div>
      <h1 class="mt-4 text-balance text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
        <PostTitle title={post.data.title} />
      </h1>
      <p class="mt-4 max-w-[32rem] text-lg text-muted">{post.data.summary}</p>
      {
        post.data.sourceLine && (
          <p class="mt-4 text-sm text-faint">
            <span class="font-semibold text-muted">Source:</span> {post.data.sourceLine}
          </p>
        )
      }
    </header>

    <!-- The Markdown body. Its tags are styled by `.post-body` in global.css. -->
    <div class="post-body mt-10">
      {
        splitBody ? (
          <>
            <Fragment set:html={bodyHtml.slice(0, cut)} />
            <FollowInline />
            <Fragment set:html={bodyHtml.slice(cut)} />
          </>
        ) : (
          <Content />
        )
      }
    </div>

    <!-- Footer: the Public Source, then the end block (byline + next steps). -->
    <footer class="mt-12 border-t border-hairline pt-6">
      {
        post.data.source && (
          <p class="max-w-md text-sm text-muted">
            <span class="font-semibold text-text">Source:</span> {post.data.source}
          </p>
        )
      }

      <div class="mt-8 flex flex-col gap-5 rounded-2xl border border-border bg-surface p-5 sm:p-6 md:flex-row md:items-center md:justify-between">
        <div class="min-w-0">
          <p class="font-display text-base font-bold tracking-tight">
            By <a href="/about" class="underline underline-offset-4 hover:opacity-80">Daryll Banal</a>
          </p>
          <p class="mt-1 text-sm text-muted">
            {
              postUrl
                ? "Got an answer or a question? Join the thread on LinkedIn."
                : "Every post goes up on LinkedIn first. Follow to catch the next one."
            }
          </p>
          <p class="mt-1 text-sm text-faint">
            New posts every {RHYTHM.days}, 7:30 AM Manila.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap md:shrink-0">
          <a
            href={postUrl ?? linkedin.url}
            target="_blank"
            rel="noopener noreferrer"
            class="press inline-flex min-h-11 items-center justify-center rounded-lg bg-accent px-5 text-sm font-semibold text-on-accent hover:opacity-90"
          >
            {postUrl ? "Answer on LinkedIn ↗" : "Follow on LinkedIn ↗"}
            <NewTabNote />
          </a>
          <a
            href={section.path}
            class="press inline-flex min-h-11 items-center justify-center rounded-lg border border-border px-5 text-sm font-semibold text-text hover:border-accent"
          >
            More {section.name} →
          </a>
        </div>
      </div>
    </footer>
  </article>
</BaseLayout>

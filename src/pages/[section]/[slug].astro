---
/* =============================================================================
   [section]/[slug].astro — the page for a single post, e.g.
   /analytics/2026-11-11-what-1000-pesos-bought
   =============================================================================
   Two route parameters this time. getStaticPaths() returns one entry per
   published post, with both the section (from its Format) and the slug (the
   file name, which Astro calls the entry's `id`). Anything returned under
   `props` is handed to the page as Astro.props, so we pass the post along.

   render(post) turns the post's Markdown body into a <Content /> component.
============================================================================= */

import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SubBrandTag from "../../components/SubBrandTag.astro";
import { BRAND, SECTIONS } from "../../lib/hub";
import { formatDate, getPosts, sectionOf, tagOf, type Post } from "../../lib/posts";
import NewTabNote from "../../components/NewTabNote.astro";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { section: sectionOf(post), slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const section = SECTIONS[sectionOf(post)];
---

<BaseLayout title={`${post.data.title} · ${BRAND.name}`} description={post.data.summary}>
  <article class="mx-auto max-w-3xl px-6 pb-20 pt-16 sm:pb-28 sm:pt-24">
    <!-- Back link to the section this post lives in. -->
    <a href={section.path} class="text-sm text-muted transition-colors hover:text-text">
      ← {section.name}
    </a>

    <header class="mt-8">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-faint">
        <SubBrandTag section={tagOf(post)} />
        <span>{post.data.format}</span>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </div>
      <h1 class="mt-4 text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
        {post.data.title}
      </h1>
      <p class="mt-4 text-lg text-muted">{post.data.summary}</p>
    </header>

    <!-- The Markdown body. Its tags are styled by `.post-body` in global.css. -->
    <div class="post-body mt-10">
      <Content />
    </div>

    <!-- Footer: Public Source + the original LinkedIn post, when given. -->
    {
      (post.data.source || post.data.linkedinUrl) && (
        <footer class="mt-12 border-t border-hairline pt-6 text-sm text-muted">
          {post.data.source && (
            <p>
              <span class="font-semibold text-text">Source:</span> {post.data.source}
            </p>
          )}
          {post.data.linkedinUrl && (
            <a
              href={post.data.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-block underline underline-offset-4 hover:text-text"
            >
              Read and comment on LinkedIn ↗
              <NewTabNote />
            </a>
          )}
        </footer>
      )
    }
  </article>
</BaseLayout>

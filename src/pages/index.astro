---
/* =============================================================================
   index.astro — the Hub home page, route "/".
   =============================================================================
   Pages live in src/pages/. index.astro -> route "/". This page composes the
   section components in order: first DB Insights (what it is, its sections,
   latest posts, where to follow), then Daryll's own portfolio (work, about,
   experience, skills, credentials, contact).

   The section pages (/spatial, /analytics, …) are built by
   src/pages/[section]/index.astro.
============================================================================= */

import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionCards from "../components/SectionCards.astro";
import LatestPosts from "../components/LatestPosts.astro";
import FollowLinks from "../components/FollowLinks.astro";
import Section from "../components/Section.astro";
import Carousel from "../components/Carousel.astro";
import DBLearningBand from "../components/DBLearningBand.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import Credentials from "../components/Credentials.astro";
import Contact from "../components/Contact.astro";
---

<BaseLayout>
  <!-- Hero: the bio line, tagline and the main follow button. -->
  <Hero />

  <!-- 01 — The sections: one card per Sub-brand + Field Notes. -->
  <SectionCards />

  <!-- 02 — Latest posts across every section (or the launch date, before launch). -->
  <LatestPosts />

  <!-- 03 — Follow: LinkedIn now; Facebook and YouTube with their start dates. -->
  <FollowLinks />

  <!-- 04 — Featured work: the carousel, sourced from the projects collection. -->
  <Section id="work" index={4} label="featured work">
    <Carousel />
  </Section>

  <!-- DBLearning: a distinct branded band in the coral Sub-brand Accent. -->
  <DBLearningBand />

  <!-- 05 — About: intro, photo, and the Gather → Store → Analyze → Present flow. -->
  <About />

  <!-- 06 — Experience: vertical timeline. -->
  <Experience />

  <!-- 07 — Skills: four grouped cards. -->
  <Skills />

  <!-- 08 — Credentials: flat grid from the credentials collection. -->
  <Credentials />

  <!-- 09 — Contact: real email + social links. -->
  <Contact />
</BaseLayout>

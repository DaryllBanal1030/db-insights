---
/* =============================================================================
   index.astro — the Hub home page, route "/".
   =============================================================================
   Pages live in src/pages/. index.astro -> route "/". The home page is about
   DB Insights: the pitch + weekly rhythm, its sections, the latest posts
   beside where to follow, the DBLearning preview, and a short "About Daryll"
   card linking to the full portfolio on /about (src/pages/about.astro).

   The section pages (/spatial, /analytics, …) are built by
   src/pages/[section]/index.astro.
============================================================================= */

import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionCards from "../components/SectionCards.astro";
import LatestAndFollow from "../components/LatestAndFollow.astro";
import DBLearningBand from "../components/DBLearningBand.astro";
import AboutTeaser from "../components/AboutTeaser.astro";
---

<BaseLayout>
  <!-- Hero: the bio line, the main follow button, and the Mon/Wed/Fri card. -->
  <Hero />

  <!-- 01 — The sections, as a bento grid (Phase 1 cards are the wide ones). -->
  <SectionCards />

  <!-- 02 — Latest posts (or the launch date) beside the follow links. -->
  <LatestAndFollow />

  <!-- DBLearning: a compact strip in the coral Sub-brand Accent (Phase 3 preview). -->
  <DBLearningBand />

  <!-- 03 — About Daryll: one card linking to /about. -->
  <AboutTeaser />
</BaseLayout>

---
/* =============================================================================
   about.astro — Daryll's page, route "/about".
   =============================================================================
   A plain file in src/pages/ becomes a route by its name: about.astro -> /about.
   This page holds everything about Daryll himself, kept short so a visitor
   gets who he is in one phone screen and the rest in about two scrolls:

     header   name, role line, 2-sentence intro (+ photo once it exists)
     01       Experience: compact timeline (the only place the employer is named)
     02       Featured work: published posts (carousel once all 3 Sub-brands have one)
     03       Skills & credentials: chips + one-line credentials
     04       Contact

   The home page links here from its "About Daryll" card and the nav.
============================================================================= */

import { existsSync } from "node:fs";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import FeaturedWork from "../components/FeaturedWork.astro";
import Experience from "../components/Experience.astro";
import SkillsCredentials from "../components/SkillsCredentials.astro";
import Contact from "../components/Contact.astro";
import { BRAND } from "../lib/hub";

// The frontmatter runs at build time, so it can check the file system. Until
// public/daryll.jpg exists the photo slot is left out (never a broken image).
const hasPhoto = existsSync("public/daryll.jpg");
---

<BaseLayout
  title={`About Daryll Banal · ${BRAND.name}`}
  description="Daryll Banal, the senior research analyst behind DB Insights: databases, data pipelines and maps, taught with Philippine public data."
>
  <!-- Header: the one <h1> on this page, plus the short intro. -->
  <section class="mx-auto max-w-6xl px-6 pt-12 sm:pt-16">
    <div class="grid gap-8 md:grid-cols-3 md:items-center" data-reveal>
      <div class:list={[hasPhoto ? "md:col-span-2" : "md:col-span-3"]}>
        <p class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-faint">
          About
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Daryll Banal</h1>
        <p class="mt-3 text-lg text-text">
          The senior research analyst behind <span class="wordmark">db insights</span>.
        </p>
        {/* No employer here: it's named only in Experience (brand rule). */}
        <p class="mt-3 max-w-prose text-muted">
          I build the data behind market research: databases, pipelines and
          maps. DB Insights is where I teach those skills with Philippine
          public data.
        </p>
      </div>
      {
        hasPhoto && (
          <div class="md:col-span-1">
            <img
              src="/daryll.jpg"
              alt="Daryll Banal"
              width="800"
              height="800"
              class="aspect-square w-full max-w-xs rounded-2xl border border-border bg-surface object-cover"
            />
          </div>
        )
      }
    </div>
  </section>

  <!-- 01 — Experience: compact timeline. -->
  <Experience />

  <!-- 02 — Featured work: real posts only, until every Sub-brand has one;
       then the one-slide-per-Sub-brand carousel (FeaturedWork.astro). -->
  <Section id="work" index={2} label="featured work">
    <FeaturedWork />
  </Section>

  <!-- 03 — Skills & credentials: chips + one-line credentials. -->
  <SkillsCredentials />

  <!-- 04 — Contact: email + social links. -->
  <Contact />
</BaseLayout>

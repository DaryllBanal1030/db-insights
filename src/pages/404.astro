---
/* =============================================================================
   404.astro — the "page not found" page.
   =============================================================================
   Astro builds this file to dist/404.html, and hosts like Vercel serve it
   automatically for any address that doesn't exist (a typo, an old link).
   It keeps the normal nav and footer (via BaseLayout) and offers a way back:
   the home page plus a link to every Hub section.
============================================================================= */

import BaseLayout from "../layouts/BaseLayout.astro";
import { BRAND, SECTION_LIST } from "../lib/hub";
---

<BaseLayout title={`Page not found · ${BRAND.name}`}>
  <section class="mx-auto max-w-3xl px-6 pb-16 pt-12 sm:pb-20 sm:pt-16">
    <p class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-faint">
      Error 404
    </p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">
      This page isn't on the map.
    </h1>
    <p class="mt-4 max-w-prose text-lg text-muted">
      The link may be old or mistyped. Try the home page, or jump to a section:
    </p>

    <a
      href="/"
      class="mt-8 inline-flex min-h-11 items-center rounded-md bg-accent px-6 text-sm font-medium text-on-accent press hover:opacity-90"
    >
      Go to the home page
    </a>

    <!-- One link per section, each with its Sub-brand Accent dot. -->
    <ul class="mt-10 grid gap-3 sm:grid-cols-2">
      {
        SECTION_LIST.map((section) => (
          <li>
            <a
              href={section.path}
              class="flex min-h-11 items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3 text-sm font-medium press hover:border-accent"
            >
              <span class:list={["h-2 w-2 rounded-full", section.barClass]} aria-hidden="true" />
              {section.name}
              <span class="ml-auto text-faint">{section.path}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

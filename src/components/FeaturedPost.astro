---
/* =============================================================================
   FeaturedPost.astro — the newest post, big, with its map. Home section 02.
   =============================================================================
   The maps are the work, so the newest one leads the home page after the
   hero: the cover in a map frame (global.css `.map-frame`) beside a large
   title. Phone: the map on top, full width. sm and up: map left (5/12),
   words right (7/12), centred against the map.

   The cover is shown whole (object-contain), never cropped: fine for the
   tall map renders, essential for charts, whose edges carry the numbers.

   The whole card is one link. The image has alt="" because the title right
   next to it already names the post (the post page carries the full alt).
   A post dated after today reads "Coming Mon Nov 23, 2026" (isUpcoming).
============================================================================= */

import SubBrandTag from "./SubBrandTag.astro";
import PostTitle from "./PostTitle.astro";
import { SECTIONS } from "../lib/hub";
import {
  accentStyleOf,
  formatDate,
  formatLabel,
  isUpcoming,
  sectionOf,
  tagOf,
  urlOf,
  type Post,
} from "../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const tag = tagOf(post);
const section = SECTIONS[sectionOf(post)];
const label = await formatLabel(post); // "Map Breakdown #1"
---

<a
  href={urlOf(post)}
  class:list={[
    "card-lift group grid overflow-hidden rounded-2xl border border-border bg-surface",
    post.data.cover && "sm:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] sm:items-center",
  ]}
  style={accentStyleOf(post)}
>
  {
    post.data.cover && (
      <span class="map-frame m-3 sm:m-4">
        <img
          src={post.data.cover}
          alt=""
          decoding="async"
          class="aspect-[4/5] w-full bg-white object-contain"
        />
      </span>
    )
  }
  <span class="flex flex-col px-5 pb-6 pt-3 sm:py-8 sm:pl-4 sm:pr-8 lg:py-10">
    <!-- A short bar in the post's Sub-brand Accent, as on the section pages. -->
    <span
      class:list={["h-1 w-10 rounded-full", tag ? tag.barClass : section.barClass]}
      aria-hidden="true"
    ></span>
    <span class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-faint sm:text-sm">
      <SubBrandTag section={tag} />
      <span>{label}</span>
      <span aria-hidden="true">·</span>
      <time datetime={post.data.date.toISOString()}>
        {isUpcoming(post) ? "Coming " : ""}{formatDate(post.data.date)}
      </time>
    </span>
    <h3 class="mt-4 text-balance text-2xl font-bold leading-tight tracking-tight sm:text-3xl lg:text-4xl">
      <PostTitle title={post.data.title} />
    </h3>
    <span class="mt-3 block max-w-prose text-muted sm:text-lg">{post.data.summary}</span>
    <span class="mt-6 inline-flex min-h-11 items-center gap-2 self-start text-sm font-semibold text-text sm:mt-8">
      <span class="underline underline-offset-4">Read the {post.data.format}</span>
      <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
    </span>
  </span>
</a>

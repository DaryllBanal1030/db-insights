---
/* =============================================================================
   Section.astro — a reusable wrapper for each anchored page section.
   =============================================================================
   Gives every section a consistent container, an anchor `id` (for the nav
   links), and the uppercase marker like "01 — featured work" in Space Grotesk.
   The number is in the Masterbrand ink; the label is uppercase and letter-spaced.

   Optional `title`: a big headline under the marker (used on the home page,
   e.g. "Pick your corner of PH data"). With a title, the title is the <h2>
   and the marker becomes a small line above it; without one, the marker
   itself is the <h2>. Either way each section has exactly one <h2>.

   `<slot />` is where the section's actual content goes — this is the Astro
   equivalent of children/props.children. `data-reveal` hooks into the
   scroll-in fade defined in global.css.
============================================================================= */

interface Props {
  id: string; // anchor target, e.g. "work" -> href="#work"
  index: number; // section number, shown zero-padded (1 -> "01")
  label: string; // lowercase marker text, e.g. "featured work"
  title?: string; // optional big headline shown under the marker
  class?: string; // optional extra classes on the <section>
}

const { id, index, label, title, class: className } = Astro.props;
const num = String(index).padStart(2, "0");
const markerClass =
  "font-display text-xs font-semibold uppercase tracking-[0.2em] text-faint";
---

<section id={id} class:list={["scroll-mt-20", className]}>
  <div class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
    {
      title ? (
        <div data-reveal>
          <p class={markerClass}>
            <span class="text-accent">{num}</span> — {label}
          </p>
          <h2 class="mt-2 text-balance text-2xl font-bold tracking-tight sm:text-3xl">
            {title}
          </h2>
        </div>
      ) : (
        <h2 class={markerClass} data-reveal>
          <span class="text-accent">{num}</span> — {label}
        </h2>
      )
    }
    <div class="mt-6" data-reveal>
      <slot />
    </div>
  </div>
</section>

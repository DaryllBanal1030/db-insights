---
/* =============================================================================
   ComingSoon.astro — the empty state for a section with no posts yet.
   =============================================================================
   Names the Sub-brand and its Phase, says when the first post lands, and
   points to LinkedIn (the Home Platform, where every post appears first).
   It disappears on its own once the section has one published post.
============================================================================= */

import { FOLLOW_LINKS, type Section } from "../lib/hub";
import NewTabNote from "./NewTabNote.astro";

interface Props {
  section: Section;
}

const { section } = Astro.props;
const linkedin = FOLLOW_LINKS.find((link) => link.platform === "LinkedIn")!;
---

<div class="rounded-xl border border-dashed border-border px-6 py-10 sm:px-10">
  <p class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-faint">
    Coming soon · Phase {section.phase}
  </p>
  <p class="mt-3 font-display text-xl font-bold tracking-tight sm:text-2xl">
    {section.name} starts in Phase {section.phase}, {section.starts}.
  </p>
  <p class="mt-3 max-w-prose text-muted">
    {section.formats.join(" and ")} will collect here. Every post goes up on
    LinkedIn first, so follow there to catch the first one.
  </p>
  <a
    href={linkedin.url}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-6 inline-flex items-center gap-2 rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-on-accent transition-opacity hover:opacity-90"
  >
    Follow on LinkedIn ↗
    <NewTabNote />
  </a>
</div>

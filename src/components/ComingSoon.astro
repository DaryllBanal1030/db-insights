---
/* =============================================================================
   ComingSoon.astro — the empty state for a section with no posts yet.
   =============================================================================
   Says when the section's first post goes up and points to LinkedIn (the
   Home Platform, where every post appears first). The wording comes from
   statusOf() in src/lib/posts.ts, the same rule as the chips everywhere else:
     - started, no post yet: "The first Data Story goes up on LinkedIn on
       Wednesday." (its weekly slot day, never a made-up date)
     - not started: "DBAutomate starts Mon Jan 4, 2027."
   A section is only called "Live" once it has a post, and then this empty
   state isn't shown at all.
============================================================================= */

import { FOLLOW_LINKS, type Section } from "../lib/hub";
import { statusOf } from "../lib/posts";
import NewTabNote from "./NewTabNote.astro";

interface Props {
  section: Section;
}

const { section } = Astro.props;
const linkedin = FOLLOW_LINKS.find((link) => link.platform === "LinkedIn")!;
const status = await statusOf(section);
---

<!-- `--hl` makes the highlight below use this section's colour (teal on
     /spatial, violet on /automate…). Field Notes keeps Insight Gold. -->
<div
  class="rounded-xl border border-dashed border-border px-6 py-10 sm:px-10"
  style={section.key === "notes" ? undefined : `--hl: var(--color-${section.key})`}
>
  <p class="flex items-center gap-2 font-display text-xs font-semibold uppercase tracking-[0.2em] text-faint">
    <span class:list={["h-1.5 w-1.5 rounded-full", section.barClass]} aria-hidden="true"></span>
    {status.state === "first" ? "First post coming" : "Coming soon"}
  </p>
  <p class="mt-3 text-balance font-display text-xl font-bold tracking-tight sm:text-2xl">
    {status.lead}<span class="insight">{status.when}</span>.
  </p>
  <p class="mt-3 max-w-prose text-muted">
    {section.formats.join(" and ")} will collect here. Every post goes up on
    LinkedIn first, so follow there to catch the first one.
  </p>
  <a
    href={linkedin.url}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-lg bg-accent px-5 text-sm font-semibold text-on-accent press hover:opacity-90"
  >
    Follow on LinkedIn ↗
    <NewTabNote />
  </a>
</div>

---
/* =============================================================================
   ComingSoon.astro — the empty state for a section with no posts yet.
   =============================================================================
   Says when the section starts and points to LinkedIn (the Home Platform,
   where every post appears first). Two wordings, picked by hasStarted() from
   src/lib/hub.ts:
     - before the section's start date: "DBAutomate starts Mon Jan 4, 2027."
     - after it (posts are on LinkedIn but not on the site yet):
       "DBSpatial posts are on LinkedIn while this page catches up."
   Field Notes go up on Fridays (the weekly rhythm), so their start line
   names the day instead of claiming the launch Monday.
   It disappears on its own once the section has one published post.
============================================================================= */

import { FOLLOW_LINKS, hasStarted, type Section } from "../lib/hub";
import NewTabNote from "./NewTabNote.astro";

interface Props {
  section: Section;
}

const { section } = Astro.props;
const linkedin = FOLLOW_LINKS.find((link) => link.platform === "LinkedIn")!;
const live = hasStarted(section.startsOn);
const isNotes = section.key === "notes";
---

<!-- `--hl` makes the highlight below use this section's colour (teal on
     /spatial, violet on /automate…). Field Notes keeps Insight Gold. -->
<div
  class="rounded-xl border border-dashed border-border px-6 py-10 sm:px-10"
  style={isNotes ? undefined : `--hl: var(--color-${section.key})`}
>
  <p class="flex items-center gap-2 font-display text-xs font-semibold uppercase tracking-[0.2em] text-faint">
    <span class:list={["h-1.5 w-1.5 rounded-full", section.barClass]} aria-hidden="true"></span>
    {live ? "Live on LinkedIn" : "Coming soon"}
  </p>
  {
    live ? (
      <>
        <p class="mt-3 text-balance font-display text-xl font-bold tracking-tight sm:text-2xl">
          {isNotes ? (
            <>New <span class="insight">Field Notes</span> go up on LinkedIn every Friday.</>
          ) : (
            <>
              {section.formats.join(" and ")} go up on LinkedIn{" "}
              <span class="insight">every week</span>.
            </>
          )}
        </p>
        <p class="mt-3 max-w-prose text-muted">
          They'll be collected here soon. Every post goes up on LinkedIn
          first, so follow there for the next one.
        </p>
      </>
    ) : (
      <>
        <p class="mt-3 text-balance font-display text-xl font-bold tracking-tight sm:text-2xl">
          {isNotes ? (
            <>
              Field Notes go up on Fridays, from the launch week of{" "}
              <span class="insight">{section.starts}</span>.
            </>
          ) : (
            <>
              {section.name} starts <span class="insight">{section.starts}</span>.
            </>
          )}
        </p>
        <p class="mt-3 max-w-prose text-muted">
          {section.formats.join(" and ")} will collect here. Every post goes up on
          LinkedIn first, so follow there to catch the first one.
        </p>
      </>
    )
  }
  <a
    href={linkedin.url}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-lg bg-accent px-5 text-sm font-semibold text-on-accent press hover:opacity-90"
  >
    Follow on LinkedIn ↗
    <NewTabNote />
  </a>
</div>

---
/* =============================================================================
   FollowLinks.astro — where to follow DB Insights, as a compact list.
   =============================================================================
   Content only (no section wrapper): the home page places it beside or under
   the latest posts in LatestAndFollow.astro (`wide` = full-width row).

   Reads FOLLOW_LINKS from src/lib/hub.ts. A platform that hasn't started yet
   shows its start note instead of a link, so there are no dead links before
   the Facebook Page (Dec 7, 2026) or YouTube (Mar 2027) go live. To switch one
   on, set its `startsNote` to null in hub.ts.
============================================================================= */

import { BRAND, FOLLOW_LINKS } from "../lib/hub";
import NewTabNote from "./NewTabNote.astro";

interface Props {
  /** Full-width row: the three platforms side by side from `sm` up. */
  wide?: boolean;
}

const { wide = false } = Astro.props;
---

<div class="rounded-2xl border border-border bg-surface p-5">
  <h3 class="font-display text-base font-bold tracking-tight">Follow along</h3>
  <p class="mt-1 text-sm text-muted">
    Every post goes up on LinkedIn first. Tag your own PH data posts with
    <span class="font-semibold text-text">{BRAND.hashtag}</span>.
  </p>

  <ul
    class:list={[
      "mt-4 divide-y divide-hairline",
      wide && "sm:grid sm:grid-cols-3 sm:gap-3 sm:divide-y-0",
    ]}
    data-stagger
  >
    {
      FOLLOW_LINKS.map((link) => (
        <li
          class:list={[
            "flex min-h-14 items-center justify-between gap-3 py-2",
            // Wide row: one cell per platform, its status or button under
            // its name, so the row reads as three groups, not six columns.
            wide && "sm:flex-col sm:items-start sm:justify-between sm:rounded-xl sm:border sm:border-hairline sm:bg-bg/40 sm:p-4",
          ]}
        >
          <span class="min-w-0">
            <span class="block text-sm font-semibold">{link.platform}</span>
            <span class="block text-xs text-faint">
              {link.handle} · {link.speaksAs === "Personal" ? "Daryll" : "Brand Page"}
            </span>
          </span>
          {link.startsNote ? (
            <span class:list={["shrink-0 text-right text-xs text-faint", wide && "sm:flex sm:min-h-11 sm:items-center sm:text-left"]}>
              {link.startsNote}
            </span>
          ) : (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 shrink-0 items-center rounded-lg bg-accent px-4 text-sm font-semibold text-on-accent press hover:opacity-90"
            >
              Follow ↗
              <NewTabNote />
            </a>
          )}
        </li>
      ))
    }
  </ul>
</div>

---
/* =============================================================================
   Hero.astro — the top-of-page introduction to Daryll and DB Insights.
   =============================================================================
   Static (no JS). A faint engineered line-grid sits behind the content at very
   low opacity, faded out toward the bottom with a CSS mask so it blends into
   the page.

   Copy comes from the brand docs: the tagline and bio line from BRAND
   (src/lib/hub.ts), the promise from the LinkedIn headline. The employer is
   named only in the Experience section, never up here (BRAND-GUIDE.md).
============================================================================= */

import { BRAND, FOLLOW_LINKS } from "../lib/hub";
import NewTabNote from "./NewTabNote.astro";

const linkedin = FOLLOW_LINKS.find((link) => link.platform === "LinkedIn")!;
---

<section
  class="relative overflow-hidden"
  aria-labelledby="hero-heading"
>
  <!-- Faint line-grid motif. `grid-motif` (from global.css) draws the lines;
       the mask fades them out toward the bottom so there's no hard edge.
       aria-hidden because it's purely decorative. -->
  <div
    class="grid-motif absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,black,transparent_85%)]"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6 pb-16 pt-24 sm:pb-24 sm:pt-32">
    <!-- Tagline: uppercase and letter-spaced, as the brand guide specifies. -->
    <p
      class="font-display text-xs font-semibold uppercase tracking-[0.25em] text-muted sm:text-sm"
      data-reveal
    >
      {BRAND.tagline}
    </p>

    <!-- Headline: the standard bio line, with the wordmark in front. -->
    <h1
      id="hero-heading"
      class="mt-6 max-w-4xl text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl"
      data-reveal
    >
      <span class="wordmark">db insights</span>: data and maps of the
      Philippines, by Daryll Banal.
    </h1>

    <!-- Subline. -->
    <p class="mt-6 max-w-2xl text-lg text-muted" data-reveal>
      I'm a research analyst teaching Filipinos to turn PH data and maps into
      better decisions. A new post every Monday, Wednesday and Friday on
      LinkedIn, built only from public data.
    </p>

    <!-- Four Sub-brand dots: a quiet preview of the sections below. -->
    <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted" data-reveal>
      <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-spatial" aria-hidden="true"></span>Maps</li>
      <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-analytics" aria-hidden="true"></span>Data stories</li>
      <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-automate" aria-hidden="true"></span>Automation</li>
      <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-learning" aria-hidden="true"></span>Lessons</li>
    </ul>

    <!-- Buttons: full width on mobile, inline from sm up. -->
    <div class="mt-10 flex flex-col gap-3 sm:flex-row" data-reveal>
      <a
        href={linkedin.url}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md bg-accent px-6 py-3 text-center text-sm font-medium text-on-accent transition-opacity hover:opacity-90"
      >
        Follow on LinkedIn ↗
        <NewTabNote />
      </a>
      <a
        href="#sub-brands"
        class="rounded-md border border-border px-6 py-3 text-center text-sm font-medium text-text transition-colors hover:border-accent"
      >
        Explore the sections
      </a>
    </div>
  </div>
</section>

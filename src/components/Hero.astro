---
/* =============================================================================
   Hero.astro — the top-of-page introduction to Daryll and DB Insights.
   =============================================================================
   Static (no JS). Two columns from the `lg` breakpoint up (1024px):
     left  — tagline, the bio-line headline, one line on the promise, buttons
     right — the "Every week" card: the Mon / Wed / Fri posting rhythm, so a
             visitor sees at a glance what they get by following.
   On phones the card stacks under the text.

   No `data-reveal` here on purpose: the hero is the first thing on screen.
   Instead it has a short entrance (classes `hero-in` / `hero-card`, see
   "MOTION" in global.css): the headline shows instantly, the pieces around
   it rise in one after another (`--i` = order), and the gold highlight
   "draws in". On Mon / Wed / Fri the script at the bottom marks today's row.

   Copy comes from the brand docs: the tagline and bio line from BRAND, the
   weekly slots from WEEKLY_SLOTS (both in src/lib/hub.ts), the promise from
   the LinkedIn headline. The employer is named only on /about (Experience).
============================================================================= */

import { BRAND, FOLLOW_LINKS, POST_TIME, SECTIONS, WEEKLY_SLOTS, hasStarted } from "../lib/hub";
import { getPosts, plainTitle, urlOf } from "../lib/posts";
import NewTabNote from "./NewTabNote.astro";
import SubBrandTag from "./SubBrandTag.astro";

const linkedin = FOLLOW_LINKS.find((link) => link.platform === "LinkedIn")!;

// The card's footer: the newest post once one is on the site; otherwise the
// launch date, worded "First post: ..." before it and "Live since ..." after.
const [latest] = await getPosts();
const launched = hasStarted(BRAND.launchOn);
---

<section class="relative overflow-hidden" aria-labelledby="hero-heading">
  <!-- Faint line-grid motif. `grid-motif` (from global.css) draws the lines;
       the mask fades them out toward the bottom so there's no hard edge.
       aria-hidden because it's purely decorative. -->
  <div
    class="grid-motif absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,black,transparent_85%)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="mx-auto grid max-w-6xl gap-10 px-6 pb-12 pt-14 sm:pb-16 sm:pt-20 lg:grid-cols-[1.3fr_1fr] lg:items-center lg:gap-14"
  >
    <!-- Left: the pitch. -->
    <div>
      <!-- Tagline: uppercase and letter-spaced, as the brand guide specifies. -->
      <p class="hero-in font-display text-xs font-semibold uppercase tracking-[0.25em] text-muted">
        {BRAND.tagline}
      </p>

      <!-- Headline: the standard bio line, with the wordmark in front.
           `text-balance` evens out the line lengths of a short headline.
           "data and maps" is this screen's ONE Insight Gold highlight
           (`.insight` in global.css): the thing to remember. -->
      <h1
        id="hero-heading"
        class="mt-5 text-balance text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl lg:text-[3.4rem]"
      >
        <span class="wordmark">db insights</span>: <span class="insight draw">data and maps</span>
        of the Philippines, by Daryll Banal.
      </h1>

      <!-- Subline. -->
      <p class="hero-in mt-5 max-w-xl text-lg text-muted" style="--i: 1">
        Learn to turn PH data and maps into better decisions, one short post
        at a time. Built only from public data.
      </p>

      <!-- Buttons: full width on mobile, inline from sm up. -->
      <div class="hero-in mt-8 flex flex-col gap-3 sm:flex-row" style="--i: 2">
        <a
          href={linkedin.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-12 items-center justify-center rounded-lg bg-accent px-6 text-sm font-semibold text-on-accent press hover:opacity-90"
        >
          Follow on LinkedIn ↗
          <NewTabNote />
        </a>
        <a
          href="#sub-brands"
          class="inline-flex min-h-12 items-center justify-center rounded-lg border border-border px-6 text-sm font-semibold text-text press hover:border-accent"
        >
          Explore the sections
        </a>
      </div>
    </div>

    <!-- Right: the weekly rhythm card. `corners` adds the gold corner
         accents, the Masterbrand signature (like a carousel's cover slide). -->
    <aside
      class="hero-card corners rounded-2xl border border-border bg-surface/80 p-5 shadow-xl shadow-black/10 backdrop-blur-sm sm:p-6"
      aria-labelledby="weekly-heading"
    >
      <div class="flex items-baseline justify-between gap-3">
        <h2 id="weekly-heading" class="font-display text-base font-bold tracking-tight">
          Every week on LinkedIn
        </h2>
        <p class="text-xs text-faint">{POST_TIME}</p>
      </div>

      <ul class="mt-4 grid gap-2">
        {
          WEEKLY_SLOTS.map((slot, i) => (
            <li
              class="hero-in flex items-center gap-3 rounded-xl border border-hairline bg-bg/60 p-3"
              style={`--i: ${i + 3}`}
              data-day={slot.day}
            >
              {/* The day, in a small square. */}
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg border border-border font-display text-sm font-bold">
                {slot.day}
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-semibold">{slot.format}</span>
                {slot.note && <span class="block text-xs text-faint">{slot.note}</span>}
                {/* Hidden until the script below finds that today is this day. */}
                <span class="today-badge mt-1 hidden items-center gap-1.5 text-xs font-semibold text-text">
                  <span class="today-ping h-1.5 w-1.5 rounded-full bg-live" aria-hidden="true" />
                  Today
                </span>
              </span>
              <SubBrandTag section={slot.section ? SECTIONS[slot.section] : null} />
            </li>
          ))
        }
      </ul>

      <p class="mt-4 border-t border-hairline pt-4 text-sm text-muted">
        {
          latest ? (
            <>
              Latest:{" "}
              <a href={urlOf(latest)} class="font-semibold text-text underline underline-offset-4">
                {plainTitle(latest.data.title)}
              </a>
            </>
          ) : launched ? (
            <>
              Live since <span class="font-semibold text-text">{BRAND.launch}</span> ·{" "}
              <a
                href={linkedin.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-text underline underline-offset-4"
              >
                see the posts ↗
                <NewTabNote />
              </a>
            </>
          ) : (
            <>
              First post: <span class="font-semibold text-text">{BRAND.launch}</span>
            </>
          )
        }
      </p>
    </aside>
  </div>
</section>

<script>
  // Marks today's posting day on the weekly card. Runs in the visitor's
  // browser, so "today" is always current even though the page itself was
  // built earlier. We use Manila time (where the posts go out), not the
  // visitor's own time zone.
  const today = new Date().toLocaleDateString("en-US", {
    weekday: "short",
    timeZone: "Asia/Manila",
  }); // e.g. "Mon"
  const row = document.querySelector<HTMLElement>(`[data-day="${today}"]`);
  if (row) {
    row.classList.add("is-today");
    row.querySelector(".today-badge")?.classList.replace("hidden", "flex");
  }
</script>

---
/* =============================================================================
   SectionCards.astro — the Hub sections: what's live, then what's coming.
   =============================================================================
   The live sections get the cards; the later ones get one quiet line each,
   so the home page talks about this week, not 2027:
     - DBSpatial, DBAnalytics and Field Notes (live from launch) are cards:
       Sub-brand Tag + status chip, the name, one line on what it covers,
       its Post Formats, and an arrow. Each has a faint dot-grid texture with
       ONE dot in its Sub-brand Accent (a highlighted data point, which is
       how the brand guide says an Accent may be used).
     - DBAutomate and DBLearning sit under "Coming in 2027", one line each
       with their dot, name, Post Format and start month, linking to their
       pages. (This replaced the big DBLearning band, Nov 22, 2026.)
   Phone: one column. sm (640px+): two columns, Field Notes full width.
   lg (1024px+): three columns.

   The status chip reads "Live" (has a post), "First Data Story: Wed" (started,
   first post not up yet) or "From Jan 2027" (statusOf in posts.ts), never
   "Phase 1". All wording comes from SECTIONS in src/lib/hub.ts.
============================================================================= */

import Section from "./Section.astro";
import SubBrandTag from "./SubBrandTag.astro";
import { SECTIONS, SECTION_LIST, type SectionKey } from "../lib/hub";
import { statusOf } from "../lib/posts";

// Cards: every section that starts with the launch (Phase 1), in order.
const cards: { key: SectionKey; span: string }[] = [
  { key: "spatial", span: "" },
  { key: "analytics", span: "" },
  { key: "notes", span: "sm:col-span-2 lg:col-span-1" },
];
// The rest, one line each. Once a section's start date passes, it would read
// "Live"; move it up into `cards` then.
const later = SECTION_LIST.filter((s) => s.phase > 1);
// The heading year comes from the data, e.g. "Coming in 2027".
const laterYears = [...new Set(later.map((s) => s.startsOn.slice(0, 4)))].join(" and ");
// Status of every section, worked out once (it counts each section's posts).
const statuses = Object.fromEntries(
  await Promise.all(SECTION_LIST.map(async (s) => [s.key, await statusOf(s)] as const)),
);
---

<Section
  id="sub-brands"
  index={2}
  label="the sections"
  title="Pick your corner of PH data"
>
  <!-- `data-stagger`: the cards rise in one after another (global.css). -->
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
    {
      cards.map(({ key, span }) => {
        const section = SECTIONS[key];
        return (
          <a
            href={section.path}
            class:list={[
              "card-lift group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-surface p-5",
              span,
            ]}
          >
            {/* Decorative texture: dot grid + one accent dot. */}
            <span class="pointer-events-none absolute -right-2 -top-2 h-28 w-36" aria-hidden="true">
              <span class="dot-grid absolute inset-0 [mask-image:radial-gradient(circle_at_top_right,black,transparent_75%)]" />
              {/* `accent-dot`: sends out one ring when the card is hovered. */}
              <span class:list={["accent-dot absolute right-12 top-10 h-2.5 w-2.5 rounded-full ring-4 ring-surface", section.barClass]} />
            </span>

            <span class="relative flex flex-wrap items-center gap-2">
              {/* Field Notes isn't a Sub-brand, so it gets the Masterbrand tag. */}
              <SubBrandTag section={key === "notes" ? null : section} />
              <span class="rounded-full border border-border px-2 py-0.5 text-xs text-muted">
                {statuses[key].label}
              </span>
            </span>

            <h3 class="relative mt-4 text-lg font-bold tracking-tight">{section.name}</h3>
            <p class="relative mt-1 flex-1 text-sm text-muted">{section.focus}</p>

            <span class="relative mt-4 flex items-center justify-between gap-3 text-xs text-faint">
              <span>{section.formats.join(" · ")}</span>
              {/* Arrow nudges right on hover (transform only, no layout shift). */}
              <span
                class="text-base text-text transition-transform duration-200 group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </span>
          </a>
        );
      })
    }
  </div>

  <!-- Coming later: one quiet line per section, no cards. -->
  {
    later.length > 0 && (
      <div class="mt-6 border-t border-hairline pt-4">
        <h3 class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-faint">
          Coming in {laterYears}
        </h3>
        <ul class="mt-2 grid gap-x-8 sm:grid-cols-2">
          {later.map((section) => (
            <li>
              <a
                href={section.path}
                class="group flex min-h-11 flex-wrap items-center gap-x-2 gap-y-0.5 py-1 text-sm text-muted transition-colors hover:text-text"
              >
                <span class:list={["h-1.5 w-1.5 rounded-full", section.barClass]} aria-hidden="true" />
                <span class="font-semibold text-text">{section.name}</span>
                <span>
                  {section.formats.join(" and ")} ·{" "}
                  {statuses[section.key].state === "later"
                    ? `from ${section.startsShort}`
                    : statuses[section.key].label}
                </span>
                <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</Section>

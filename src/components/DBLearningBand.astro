---
/* =============================================================================
   DBLearningBand.astro — a distinct band on the home page for DBLearning.
   =============================================================================
   DBLearning is the Sub-brand for upskilling: short on-camera Lessons that
   teach Learners (students, fresh grads, career shifters, early-career
   analysts) one data skill each. It starts in Phase 3 (Mon Mar 1, 2027), on
   YouTube @daryllbanal. See dbinsights-brand/CONTEXT.md.

   Deliberately different from the project cards so it stands out:
     - centered layout (the project cards are left-aligned)
     - a soft glow + gradient in the DBLearning coral (#FF6B5B), the
       Sub-brand Accent from BRAND-GUIDE.md (`bg-learning` in Tailwind)
     - a coral call-to-action, with navy text (white on coral is too
       low-contrast to read)

   All the facts (Phase, start date, YouTube handle) come from src/lib/hub.ts.
   Before Phase 3 the YouTube line shows its start note; once you set the
   YouTube `startsNote` to null in hub.ts, it turns into a Subscribe link.
   Static — no API.
============================================================================= */

import SubBrandTag from "./SubBrandTag.astro";
import { FOLLOW_LINKS, SECTIONS } from "../lib/hub";

const learning = SECTIONS.learning;
const youtube = FOLLOW_LINKS.find((link) => link.platform === "YouTube")!;
---

<section id="dblearning" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
    <!-- The band itself: rounded, gradient surface, distinct from cards. -->
    <div
      class="relative overflow-hidden rounded-2xl border border-border bg-gradient-to-br from-surface to-bg px-6 py-12 text-center sm:px-12 sm:py-16"
      data-reveal
    >
      <!-- Decorative coral glow (purely visual). aria-hidden so screen
           readers skip it. `var(--color-learning)` is the coral token
           defined in global.css. -->
      <div
        class="pointer-events-none absolute -top-24 left-1/2 h-64 w-[36rem] -translate-x-1/2 rounded-full opacity-20 blur-3xl"
        style="background: radial-gradient(closest-side, var(--color-learning), transparent);"
        aria-hidden="true"
      >
      </div>

      <div class="relative">
        <!-- Sub-brand Tag + heading, the same pattern as the section pages. -->
        <SubBrandTag section={learning} />
        <h2 class="mt-4 text-2xl font-bold tracking-tight sm:text-3xl">
          Learn the data skills behind every post
        </h2>

        <!-- Audience + Phase pills. -->
        <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
          <span
            class="rounded-full border border-border bg-bg/40 px-3 py-1 text-xs text-muted"
          >
            for students, fresh grads &amp; career shifters
          </span>
          <span
            class="inline-flex items-center gap-2 rounded-full border border-border px-3 py-1 text-xs text-muted"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-learning" aria-hidden="true"
            ></span>
            Phase {learning.phase} · from {learning.starts}
          </span>
        </div>

        <!-- One-line description. -->
        <p class="mx-auto mt-6 max-w-xl text-muted">
          Short on-camera Lessons, 60 to 90 seconds each, that teach one data,
          GIS or automation skill you can put to use.
        </p>

        <!-- Call-to-action: the /learning section, in the DBLearning coral. -->
        <div class="mt-8 flex flex-col items-center gap-3">
          <a
            href={learning.path}
            class="inline-flex items-center gap-2 rounded-md bg-learning px-6 py-3 text-sm font-semibold text-navy transition-opacity hover:opacity-90"
          >
            See {learning.name} →
          </a>

          <!-- YouTube: a note until Phase 3, then a link (see hub.ts). -->
          {
            youtube.startsNote ? (
              <p class="text-sm text-faint">
                On YouTube as {youtube.handle} · {youtube.startsNote}
              </p>
            ) : (
              <a
                href={youtube.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium text-text underline underline-offset-4 hover:opacity-80"
              >
                Subscribe on YouTube, {youtube.handle} ↗
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

---
/* =============================================================================
   DBLearningBand.astro — a distinct band on the home page for DBLearning.
   =============================================================================
   DBLearning is the Sub-brand for upskilling: short on-camera Lessons that
   teach Learners (students, fresh grads, career shifters, early-career
   analysts) one data skill each. It starts in Phase 3 (Mon Mar 1, 2027), on
   YouTube @daryllbanal. See dbinsights-brand/CONTEXT.md.

   A compact strip that stands apart from the cards around it:
     - text on the left, the call-to-action on the right (stacked on phones)
     - a soft glow in the DBLearning coral (#FF6B5B), the Sub-brand Accent
       from BRAND-GUIDE.md (`bg-learning` in Tailwind)
     - a coral call-to-action, with navy text (white on coral is too
       low-contrast to read)

   All the facts (Phase, start date, YouTube handle) come from src/lib/hub.ts.
   Before Phase 3 the YouTube line shows its start note; once you set the
   YouTube `startsNote` to null in hub.ts, it turns into a Subscribe link.
   Static — no API.
============================================================================= */

import SubBrandTag from "./SubBrandTag.astro";
import { FOLLOW_LINKS, SECTIONS } from "../lib/hub";
import NewTabNote from "./NewTabNote.astro";

const learning = SECTIONS.learning;
const youtube = FOLLOW_LINKS.find((link) => link.platform === "YouTube")!;
---

<section id="dblearning" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-6 py-6 sm:py-8">
    <!-- The strip itself: rounded, gradient surface, distinct from cards. -->
    <div
      class="relative overflow-hidden rounded-2xl border border-border bg-gradient-to-br from-surface to-bg p-6 sm:p-8"
      data-reveal
    >
      <!-- Decorative coral glow (purely visual). aria-hidden so screen
           readers skip it. `var(--color-learning)` is the coral token
           defined in global.css. -->
      <div
        class="pointer-events-none absolute -left-16 -top-24 h-64 w-[28rem] rounded-full opacity-20 blur-3xl"
        style="background: radial-gradient(closest-side, var(--color-learning), transparent);"
        aria-hidden="true"
      >
      </div>

      <div class="relative grid gap-6 md:grid-cols-[1fr_auto] md:items-center md:gap-10">
        <!-- Left: tag, heading, pills, one line of description. -->
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <SubBrandTag section={learning} />
            <span class="inline-flex items-center gap-2 rounded-full border border-border px-2.5 py-0.5 text-xs text-muted">
              <span class="h-1.5 w-1.5 rounded-full bg-learning" aria-hidden="true"></span>
              Phase {learning.phase} · from {learning.starts}
            </span>
          </div>
          <h2 class="mt-3 text-balance text-2xl font-bold tracking-tight">
            Learn the data skills behind every post
          </h2>
          <p class="mt-2 max-w-xl text-sm text-muted">
            Short on-camera Lessons, 60 to 90 seconds each, for students, fresh
            grads and career shifters. Each one teaches one data, GIS or
            automation skill you can put to use.
          </p>
        </div>

        <!-- Right: call-to-action to /learning, then the YouTube line. -->
        <div class="flex flex-col gap-2 md:items-end">
          <a
            href={learning.path}
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-learning px-6 text-sm font-semibold text-navy press hover:opacity-90"
          >
            See {learning.name} →
          </a>

          <!-- YouTube: a note until Phase 3, then a link (see hub.ts). -->
          {
            youtube.startsNote ? (
              <p class="text-xs text-faint md:text-right">
                On YouTube as {youtube.handle} · {youtube.startsNote}
              </p>
            ) : (
              <a
                href={youtube.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center text-sm font-medium text-text underline underline-offset-4 hover:opacity-80"
              >
                Subscribe on YouTube, {youtube.handle} ↗
                <NewTabNote />
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

---
/* =============================================================================
   PostList.astro — a list of post cards (title, date, Format, Sub-brand Tag).
   =============================================================================
   Used on the home page ("latest posts", across every section) and on each
   section page. It receives the posts already fetched and sorted; it only
   renders them. The empty case is handled by the page (see ComingSoon).
============================================================================= */

import SubBrandTag from "./SubBrandTag.astro";
import PostTitle from "./PostTitle.astro";
import { accentStyleOf, formatDate, tagOf, urlOf, type Post } from "../lib/posts";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<!-- `data-stagger`: posts rise in one after another (global.css). -->
<ul class="grid gap-3" data-stagger>
  {
    posts.map((post) => (
      <li>
        <a
          href={urlOf(post)}
          class="card-lift group block rounded-2xl border border-border bg-surface p-4 sm:p-5"
          style={accentStyleOf(post)}
        >
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-faint">
            <SubBrandTag section={tagOf(post)} />
            <span>{post.data.format}</span>
            <span aria-hidden="true">·</span>
            {/* <time datetime> gives machines the exact date; people see the nice one. */}
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </div>
          <h3 class="mt-2 text-base font-bold tracking-tight sm:text-lg">
            <PostTitle title={post.data.title} />
          </h3>
          <p class="mt-1 text-muted">{post.data.summary}</p>
        </a>
      </li>
    ))
  }
</ul>

---
/* =============================================================================
   AboutTeaser.astro — a short "About Daryll" section on the home page.
   =============================================================================
   The full portfolio lives on /about (src/pages/about.astro). This keeps the
   "Daryll" half of the home page's job ("Daryll + DB Insights overview") in
   two sentences and two links, so the home page stays short on a phone.
   The employer is named on /about (Experience), not here.
============================================================================= */

import Section from "./Section.astro";
---

<Section id="about-daryll" index={4} label="about daryll">
  <p class="max-w-prose text-lg text-muted">
    Behind DB Insights is me, Daryll Banal: a research analyst who builds
    Python and SQL data pipelines, dashboards and downloadable datasets, and
    who is growing into data engineering.
  </p>

  <div class="mt-8 flex flex-col gap-3 sm:flex-row">
    <a
      href="/about"
      class="inline-flex min-h-11 items-center justify-center rounded-md bg-accent px-6 text-sm font-medium text-on-accent transition-opacity hover:opacity-90"
    >
      My work and experience →
    </a>
    <a
      href="/about#contact"
      class="inline-flex min-h-11 items-center justify-center rounded-md border border-border px-6 text-sm font-medium text-text transition-colors hover:border-accent"
    >
      Get in touch
    </a>
  </div>
</Section>

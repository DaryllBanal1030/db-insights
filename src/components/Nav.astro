---
/* =============================================================================
   Nav.astro — sticky top navigation.
   =============================================================================
   Left:  the Solid Mark + the lowercase "db insights" wordmark (links home).
   Right: the Hub sections (/spatial … /notes), each with a dot in its
          Sub-brand Accent, an About link, a Follow button (sm and up), and
          the theme toggle.
   Mobile: the links collapse into a <details> dropdown (a native, accessible,
           zero-JS disclosure widget — no framework island needed). The
           dropdown ends with its own Follow button, since the bar's one is
           hidden on the narrowest phones.
============================================================================= */

import ThemeToggle from "./ThemeToggle.astro";
import BrandMark from "./BrandMark.astro";
import NewTabNote from "./NewTabNote.astro";
import { FOLLOW_LINKS, SECTION_LIST } from "../lib/hub";

const linkedin = FOLLOW_LINKS.find((link) => link.platform === "LinkedIn")!;

// The nav links, built from the sections in src/lib/hub.ts plus "About"
// (the portfolio page, src/pages/about.astro).
const links = [
  ...SECTION_LIST.map((section) => ({
    href: section.path,
    label: section.name,
    dot: section.barClass,
  })),
  { href: "/about", label: "About", dot: null },
];

// Astro.url is the URL of the page being built. We use it to mark the link
// for the current section with aria-current="page" (screen readers announce
// it, and the CSS below underlines it). startsWith also catches post pages
// like /spatial/some-post.
const current = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes("#") && current.startsWith(href);
---

<!-- `site-header` gives the bar a view-transition name (global.css), so it
     stays still while the rest of the page cross-fades between pages. -->
<header
  class="site-header sticky top-0 z-40 border-b border-hairline bg-bg/80 backdrop-blur-md"
>
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-2"
  >
    <!-- Brand lockup: Solid Mark + wordmark. Links to the home page. -->
    <a href="/" class="flex min-h-11 items-center gap-2.5" aria-label="DB Insights — home">
      <BrandMark class="h-8 w-auto text-text" />
      <span class="wordmark text-lg">db insights</span>
    </a>

    <!-- Right cluster. -->
    <div class="flex items-center gap-3 lg:gap-6">
      <!-- Desktop links: hidden below lg (they live in the dropdown there). -->
      <ul class="hidden items-center gap-5 lg:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
                class="nav-link flex min-h-11 items-center gap-2 text-sm text-muted transition-colors hover:text-text"
              >
                {link.dot && (
                  <span class:list={["h-1.5 w-1.5 rounded-full", link.dot]} aria-hidden="true" />
                )}
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Follow button: the one call-to-action that matters most, always in
           reach. Hidden on the narrowest phones (there isn't room, and the
           hero's big Follow button is right below). -->
      <a
        href={linkedin.url}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden min-h-11 items-center rounded-lg bg-accent px-4 text-sm font-semibold text-on-accent press hover:opacity-90 sm:inline-flex"
      >
        Follow ↗
        <NewTabNote />
      </a>

      <!-- Theme toggle: a single instance, visible at every breakpoint. -->
      <ThemeToggle />

      <!-- Mobile menu: native <details> disclosure, only shown below lg. -->
      <details class="nav-menu relative lg:hidden">
        <summary
          class="grid h-11 w-11 cursor-pointer list-none place-items-center rounded-md border border-border text-muted transition-colors hover:text-text hover:border-accent"
          aria-label="Open navigation menu"
        >
          <!-- Hamburger icon. -->
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
        </summary>

        <!-- Dropdown panel: absolutely positioned under the button. -->
        <div
          class="absolute right-0 top-full mt-2 flex w-56 flex-col gap-1 rounded-lg border border-border bg-surface p-2 shadow-xl shadow-black/20"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
                class="nav-link flex min-h-11 items-center gap-2.5 rounded-md px-3 text-sm text-muted transition-colors hover:bg-bg hover:text-text"
              >
                {link.dot && (
                  <span class:list={["h-1.5 w-1.5 rounded-full", link.dot]} aria-hidden="true" />
                )}
                {link.label}
              </a>
            ))
          }
          <a
            href={linkedin.url}
            target="_blank"
            rel="noopener noreferrer"
            class="press mt-1 flex min-h-11 items-center justify-center rounded-md bg-accent px-3 text-sm font-semibold text-on-accent hover:opacity-90"
          >
            Follow on LinkedIn ↗
            <NewTabNote />
          </a>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  /* Hide the default disclosure triangle on the <summary>. */
  .nav-menu summary::-webkit-details-marker {
    display: none;
  }
  .nav-menu summary {
    list-style: none;
  }
  /* The current section's link: full text colour + underline. */
  .nav-link[aria-current="page"] {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 6px;
  }
</style>

<script>
  // Progressive enhancement (NOT an island — just a tiny vanilla listener):
  // close the mobile dropdown after a link is tapped, and when clicking away.
  const menu = document.querySelector<HTMLDetailsElement>(".nav-menu");
  if (menu) {
    menu.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => menu.removeAttribute("open")),
    );
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) {
        menu.removeAttribute("open");
      }
    });
  }
</script>

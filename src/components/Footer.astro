---
/* =============================================================================
   Footer.astro — site footer.
   =============================================================================
   Left: the Solid Mark + the copyright line. Right: the brand hashtag. "DB Insights" is always two words (never "DBInsights").
============================================================================= */

import BrandMark from "./BrandMark.astro";
import { BRAND } from "../lib/hub";
---

<footer class="border-t border-hairline">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="flex items-center gap-2.5 text-sm text-faint">
      <BrandMark class="h-5 w-auto text-muted" />
      © 2026 {BRAND.name} · by Daryll Banal
    </p>
    <p class="text-sm text-faint">
      {BRAND.hashtag}
    </p>
  </div>
</footer>

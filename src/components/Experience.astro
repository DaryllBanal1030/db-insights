---
/* =============================================================================
   Experience.astro — a vertical timeline.
   =============================================================================
   Static. Entries are a plain data array; the markup maps over them. A vertical
   line runs down the left, with an accent dot marking each entry.

   An entry can list several `roles` at the same organisation (newest first),
   so a promotion shows as one entry with its progression instead of separate
   cards. Source for the PRIME roles and dates: Daryll's resume (Oct 2026).
   This section is the ONLY place on the site that names the employer.
============================================================================= */

import Section from "./Section.astro";

interface Role {
  title: string;
  period: string;
}
interface Entry {
  org: string;
  roles: Role[]; // newest first; the first one is the current/last role
  bullets: string[];
  tags: string[];
}

const timeline: Entry[] = [
  {
    org: "PRIME Philippines – Research & Advisory",
    roles: [
      { title: "Senior Research Analyst", period: "Aug 2026 – present" },
      { title: "Research Analyst", period: "May 2025 – Aug 2026" },
      { title: "Data Analyst Intern", period: "Jan – Mar 2025" },
    ],
    bullets: [
      "Designed and run the team's research database (PostgreSQL, hosted in Docker).",
      "Lead feasibility, highest-and-best-use and market-scan studies from data collection to client presentation.",
      "Validate and deduplicate multi-source market data, and map sites and catchments in QGIS.",
    ],
    tags: ["Python", "SQL", "PostgreSQL", "Docker", "QGIS", "Power BI"],
  },
  {
    org: "Independent",
    roles: [{ title: "Self-directed data projects", period: "2024 – ongoing" }],
    bullets: [
      "Designed an end-to-end Philippine macroeconomy dashboard with downloadable CSV exports.",
      "Modeled data in PostgreSQL and built ETL workflows to keep the series up to date.",
      "Used these projects to deepen data-engineering skills beyond day-to-day analysis.",
    ],
    tags: ["PostgreSQL", "Streamlit", "ETL", "Docker"],
  },
  {
    org: "Pamantasan ng Lungsod ng Maynila",
    roles: [{ title: "BS Computer Engineering, cum laude", period: "2021 – 2025" }],
    bullets: [
      "Graduated cum laude with a focus on computing fundamentals and systems.",
      "Built a foundation in programming, databases, and engineering problem-solving.",
    ],
    tags: ["Computer Engineering", "Programming", "Databases"],
  },
];
---

<Section id="experience" index={3} label="experience">
  <ol class="relative space-y-12 border-l border-border">
    {
      timeline.map((entry) => (
        <li class="relative pl-8">
          {/* Accent dot sitting on the line; bg fill so the line passes behind. */}
          <span
            class="absolute -left-[7px] top-1.5 h-3.5 w-3.5 rounded-full border-2 border-accent bg-bg"
            aria-hidden="true"
          />
          <p class="font-display font-semibold text-xs uppercase tracking-[0.15em] text-faint">
            {entry.roles[0].period}
          </p>
          <h3 class="mt-2 text-lg font-semibold tracking-tight">
            {entry.roles[0].title}
            <span class="text-muted"> · {entry.org}</span>
          </h3>
          {/* Earlier roles at the same organisation: the promotion path. */}
          {entry.roles.length > 1 && (
            <ul class="mt-2 space-y-1 text-sm text-muted">
              {entry.roles.slice(1).map((r) => (
                <li>
                  {r.title} <span class="text-faint">· {r.period}</span>
                </li>
              ))}
            </ul>
          )}
          <ul class="mt-3 space-y-2">
            {entry.bullets.map((b) => (
              <li class="flex gap-3 text-muted">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-faint" aria-hidden="true" />
                <span>{b}</span>
              </li>
            ))}
          </ul>
          <ul class="mt-4 flex flex-wrap gap-2">
            {entry.tags.map((tag) => (
              <li class="rounded-md border border-hairline px-2.5 py-1 text-xs text-muted">
                {tag}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>

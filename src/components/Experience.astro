---
/* =============================================================================
   Experience.astro — a compact timeline (role, organisation, dates).
   =============================================================================
   Static. Entries are a plain data array; the markup maps over them. A thin
   line runs down the left with a dot per entry, and each entry is at most a
   few short lines, so the whole section fits on a phone screen.

   An entry can list several `roles` at the same organisation (newest first),
   so a promotion shows as ONE entry with its progression instead of separate
   cards. An optional `summary` adds one line on what the work is.
   Sources: Daryll's resume (Oct 2026) for the PRIME roles and dates, and for
   the degree (cum laude, 2025).
   This section is the ONLY place on the site that names the employer.
============================================================================= */

import Section from "./Section.astro";

interface Role {
  title: string;
  period: string;
}
interface Entry {
  org: string;
  roles: Role[]; // newest first; the first one is the current/last role
  summary?: string; // one line, no client names or project specifics
}

const timeline: Entry[] = [
  {
    org: "PRIME Philippines – Research & Advisory",
    roles: [
      { title: "Senior Research Analyst", period: "Aug 2026 – present" },
      { title: "Research Analyst", period: "May 2025 – Aug 2026" },
      { title: "Data Analyst Intern", period: "Jan – Mar 2025" },
    ],
    summary:
      "Built and run the team's research database, lead feasibility and market studies end to end, and map sites and catchments in QGIS.",
  },
  {
    org: "Pamantasan ng Lungsod ng Maynila",
    roles: [{ title: "BS Computer Engineering, cum laude", period: "2025" }],
  },
];
---

<Section id="experience" index={1} label="experience">
  <ol class="relative space-y-6 border-l border-border">
    {
      timeline.map((entry) => (
        <li class="relative pl-6">
          {/* Dot sitting on the line; bg fill so the line passes behind. */}
          <span
            class="absolute -left-[6px] top-1.5 h-3 w-3 rounded-full border-2 border-accent bg-bg"
            aria-hidden="true"
          />
          {/* Line 1: current role · organisation, with the dates beside it
              (they wrap under it on narrow phones). */}
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
            <h3 class="font-semibold tracking-tight">
              {entry.roles[0].title}
              <span class="font-normal text-muted"> · {entry.org}</span>
            </h3>
            <p class="text-sm text-faint">{entry.roles[0].period}</p>
          </div>
          {/* Earlier roles at the same organisation: the promotion path. */}
          {entry.roles.length > 1 && (
            <ul class="mt-1 text-sm text-muted">
              {entry.roles.slice(1).map((r) => (
                <li>
                  {r.title} <span class="text-faint">· {r.period}</span>
                </li>
              ))}
            </ul>
          )}
          {entry.summary && <p class="mt-2 max-w-prose text-sm text-muted">{entry.summary}</p>}
        </li>
      ))
    }
  </ol>
</Section>

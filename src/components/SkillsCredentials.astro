---
/* =============================================================================
   SkillsCredentials.astro — skills as chips + credentials as one-liners.
   =============================================================================
   Replaces the old separate Skills (4 cards) and Credentials (5 cards)
   sections, so /about stays short on a phone.
   - Skills: three short chip rows, taken from the "Technical Skills" in
     Daryll's resume (Oct 2026). Edit the `skills` array below to change them.
   - Credentials: one line each (title · issuer · date · Verify ↗), read from
     the credentials collection (src/content/credentials/*.md), so adding a
     credential is still one .md file.
============================================================================= */

import { getCollection } from "astro:content";
import Section from "./Section.astro";
import NewTabNote from "./NewTabNote.astro";

const skills = [
  {
    group: "Data & infrastructure",
    items: ["Python", "SQL", "PostgreSQL", "Docker", "DBeaver", "NocoDB", "Git"],
  },
  {
    group: "Geospatial & analytics",
    items: ["QGIS", "Spatial analysis", "Site & catchment mapping", "Power BI", "Excel", "Jupyter"],
  },
  {
    group: "Methods",
    items: ["Database design", "ETL pipelines", "Data validation & QA", "Statistical analysis"],
  },
];

const credentials = (await getCollection("credentials")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Section id="skills" index={3} label="skills & credentials">
  <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
    <!-- Skills: one row of chips per group. -->
    <div class="space-y-4">
      {
        skills.map((row) => (
          <div>
            <h3 class="font-display text-xs font-semibold uppercase tracking-[0.15em] text-faint">
              {row.group}
            </h3>
            <ul class="mt-2 flex flex-wrap gap-2">
              {row.items.map((item) => (
                <li class="rounded-md border border-hairline px-2.5 py-1 text-xs text-muted">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Credentials: one line each. -->
    <div>
      <h3 class="font-display text-xs font-semibold uppercase tracking-[0.15em] text-faint">
        Credentials
      </h3>
      <ul class="mt-2 divide-y divide-hairline">
        {
          credentials.map((cred) => {
            const { title, issuer, year, verifyUrl } = cred.data;
            return (
              <li class="flex min-h-11 flex-wrap items-center justify-between gap-x-4 py-2">
                <p class="text-sm">
                  <span class="font-semibold">{title}</span>
                  <span class="text-muted"> · {issuer}</span>
                  {year && <span class="text-faint"> · {year}</span>}
                </p>
                {verifyUrl && (
                  <a
                    href={verifyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center text-xs font-semibold text-text underline underline-offset-4 hover:opacity-80"
                  >
                    Verify ↗
                    <NewTabNote />
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</Section>
